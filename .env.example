# Default: use the installed Codex CLI and your ChatGPT sign-in. No API key needed.
CAREPLAY_AI_PROVIDER=codex
CAREPLAY_DEMO=false
# Experimental isolated execution: requires a local Linux Docker engine and reviewed image.
# See docs/ISOLATED-PREVIEW.md. Leave disabled until prerequisites are ready.
CAREPLAY_SANDBOX=disabled
# Optional executable path if codex is not on PATH (Windows app is auto-detected).
CODEX_CLI_PATH=
# Optional model override; blank uses the CLI default.
CODEX_MODEL=
# Only needed when CAREPLAY_AI_PROVIDER=openai. Never use VITE_ for a key.
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible endpoint:
OPENAI_BASE_URL=
